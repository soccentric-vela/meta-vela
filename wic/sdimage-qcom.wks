# Qualcomm Snapdragon QCS6490 (RB3 Gen 2) SD card image — A/B OTA layout
#
# p1  /boot    512 MB   vfat    EFI System Partition (systemd-boot / UKI)
# p2  /        8192 MB  ext4    rootfs-a  (active slot, populated at build time)
# p3  <none>   8192 MB  ext4    rootfs-b  (standby slot, written by SWUpdate)
# p4  /home    512 MB → grows to fill card on first boot via vela-data-init
#
# Snapdragon boots via UEFI firmware + systemd-boot (EFI System Partition);
# the kernel and DTB are provided as a FIT/UKI image. SWUpdate writes the
# new rootfs to the inactive slot (p2 or p3) and flips the boot label to the
# new PARTUUID.

part /boot --source bootimg-efi --sourceparams="loader=systemd-boot" --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --fixed-size 512M

part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 8192M

part --source empty --ondisk mmcblk0 --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 8192M

part /home --source empty --ondisk mmcblk0 --fstype=ext4 --label home --align 4096 --fixed-size 512M

bootloader --timeout=5 --append="rootwait"
